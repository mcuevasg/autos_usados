# Copia este archivo a .env.local y completa los valores reales.
# Estas credenciales se obtienen desde el dashboard de Supabase:
# Project Settings > API.

# URL del proyecto Supabase (ej. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública) del proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role (secreta, NUNCA exponer al navegador ni prefijar con
# NEXT_PUBLIC_). Se usa solo en Server Actions/Route Handlers para
# operaciones que bypassan RLS a propósito (ej. promover profiles.role a
# 'vendedor' en T-07, ver lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Clave API de Resend (secreta), usada solo server-side (lib/email.ts)
# para enviar notificaciones por email (T-20). Se obtiene desde el
# dashboard de Resend. Mientras la cuenta no tenga un dominio propio
# verificado, Resend en modo sandbox solo entrega correos a la casilla
# con la que se creó la cuenta.
RESEND_API_KEY=tu-resend-api-key
