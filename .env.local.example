# Copia este archivo a .env.local y completa los valores reales.
# Estas credenciales se obtienen desde el dashboard de Supabase:
# Project Settings > API.

# URL del proyecto Supabase (ej. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública) del proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role (secreta, NUNCA exponer al navegador ni prefijar con
# NEXT_PUBLIC_). Se usa solo en Server Actions/Route Handlers para
# operaciones que bypassan RLS a propósito (ej. promover profiles.role a
# 'vendedor' en T-07, ver lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Clave API de Resend (secreta), usada solo server-side (lib/email.ts)
# para enviar notificaciones por email (T-20). Se obtiene desde el
# dashboard de Resend. Mientras la cuenta no tenga un dominio propio
# verificado, Resend en modo sandbox solo entrega correos a la casilla
# con la que se creó la cuenta.
RESEND_API_KEY=tu-resend-api-key

# Credenciales del LLM de Groq (secreta la primera), usadas solo
# server-side (lib/groq-chat.ts) por el Asistente de Compra con IA
# (T-29, POST /api/asistente/chat). NUNCA se exponen al navegador.
#
# T-29 se implementó originalmente contra NVIDIA NIM, pero esa cuenta
# quedó bloqueada por un permiso de organización sin solución self-service
# (403 "Authorization failed" en /chat/completions, ver .project/tasks.md).
# Se migró a Groq: mismo formato de API "chat completions" compatible con
# OpenAI, sin ese bloqueo, con tier gratuito sin tarjeta de crédito
# (console.groq.com > API Keys).
GROQ_API_KEY=tu-groq-api-key

# URL base de la API de Groq, compatible con la API de chat completions
# de OpenAI (POST {endpoint}/chat/completions).
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1

# Identificador del modelo de Groq a usar en cada llamada. Groq
# descontinúa modelos con cierta frecuencia (verificado: T-29 tuvo que
# cambiar de `llama-3.3-70b-versatile`, ya retirado, a este); revisa el
# catálogo vigente con `GET {endpoint}/models` o en console.groq.com si
# este deja de funcionar.
GROQ_MODEL_ID=openai/gpt-oss-20b
